#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
# Installed: /usr/lib/spaced-monitor; staged: <prefix>/usr/lib/spaced-monitor;
# from a checkout: the repo root. Require __main__.py so a stale directory - one
# left behind by a purge, for instance - cannot shadow a working tree.
for root in ("/usr/lib/spaced-monitor",
             os.path.join(here, os.pardir, "lib", "spaced-monitor"),
             os.path.dirname(here)):
    if os.path.isfile(os.path.join(root, "spaced_monitor", "__main__.py")):
        sys.path.insert(0, root)
        break

# Bytecode belongs in the user cache, never in the system prefix: a root run
# must not leave files dpkg knows nothing about.
sys.pycache_prefix = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "spaced-monitor")

from spaced_monitor.__main__ import main  # noqa: E402

sys.exit(main())
