#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
# Installed: /usr/lib/spaced-monitor; staged: <prefix>/usr/lib/spaced-monitor;
# from a checkout: the repo root.
for root in ("/usr/lib/spaced-monitor",
             os.path.join(here, os.pardir, "lib", "spaced-monitor"),
             os.path.dirname(os.path.dirname(here))):
    if os.path.isdir(os.path.join(root, "spaced_monitor")):
        sys.path.insert(0, root)
        break

from spaced_monitor.__main__ import main  # noqa: E402

sys.exit(main())
