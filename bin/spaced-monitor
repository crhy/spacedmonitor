#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
# Installed: /usr/lib/spaced-monitor; staged: <prefix>/usr/lib/spaced-monitor;
# from a checkout: the repo root.  The tree next to the launcher is tried
# first (for the installed script that is /usr/lib/spaced-monitor anyway; for a
# staged copy it is the package being built), then the checkout the launcher
# sits in, and only then the system-wide install: run from a checkout, the
# launcher must run that checkout's code, not whatever version is installed.
# Require __main__.py so a stale directory - one left behind by a purge, for
# instance - cannot shadow a working tree.
for root in (os.path.join(here, os.pardir, "lib", "spaced-monitor"),
             os.path.dirname(here),
             "/usr/lib/spaced-monitor"):
    if os.path.isfile(os.path.join(root, "spaced_monitor", "__main__.py")):
        sys.path.insert(0, root)
        break

# Bytecode belongs in the user cache, never in the system prefix: a root run
# must not leave files dpkg knows nothing about.
sys.pycache_prefix = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "spaced-monitor")

from spaced_monitor.__main__ import main  # noqa: E402

sys.exit(main())
